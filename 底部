    print("====== 欢迎进入大模型对话模式 ======")
    while True:
        user_input = input("\n用户 (User): ")
        if user_input.strip() == "exit":
            print("退出对话。")
            break
        if not user_input.strip():
            continue
            
        # 1. 先将你输入的文本转换成模型认得的数字编码 (ids)
        ids = tok.encode(user_input, add_bos=True)
        
        # 2. 调用模型正确的生成方法 model.generate
        out = model.generate(ids, max_new_n=64, temperature=0.8, top_p=0.95, seed=None)
        
        # 3. 将数字编码解码回人类看得懂的文字
        response = tok.decode(out)
        
        print(f"模型 (Bot): {response}")


if __name__ == "__main__":
    main()
